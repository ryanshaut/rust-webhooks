                    "datasource": {
                      "name": "$datasource"
                    },
                    "group": "postgres",
                    "kind": "DataQuery",
                    "spec": {
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH enriched AS (\n  SELECT\n    COALESCE(NULLIF(split_part(regexp_replace(path, '^/api/webhooks/?', ''), '/', 1), ''), 'unknown') AS tenant,\n    COALESCE(NULLIF(split_part(regexp_replace(path, '^/api/webhooks/?', ''), '/', 2), ''), 'unknown') AS app,\n    COALESCE(NULLIF(split_part(regexp_replace(path, '^/api/webhooks/?', ''), '/', 3), ''), 'unknown') AS event\n  FROM incoming_webhooks\n  WHERE $__timeFilter(received_at)\n)\nSELECT COUNT(DISTINCT tenant) AS value FROM enriched;"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
