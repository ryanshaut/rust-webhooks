                  },
                  "properties": [
                    {
                      "id": "links",
                      "value": [
                        {
                          "targetBlank": true,
                          "title": "Open payload detail",
                          "url": "/d/webhook-payload-detail/webhook-payload-detail?var-webhook_id=${__value.raw}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "options": {
              "cellHeight": "sm",
              "showHeader": true,
              "sortBy": [
                {
                  "desc": true,
                  "displayName": "received_at"
                }
              ]
            }
          },
          "version": "13.1.0"
        }
      }
