    "panel-1": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "$datasource"
                    },
                    "group": "postgres",
                    "kind": "DataQuery",
                    "spec": {
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH enriched AS (\n  SELECT\n    w.status,\n    w.active,\n    COALESCE(NULLIF(w.tenant, ''), 'unknown') AS tenant,\n    COALESCE(NULLIF(w.app, ''), 'unknown') AS app,\n    COALESCE(NULLIF(w.event, ''), 'unknown') AS event,\n    w.path,\n    w.body_text\n  FROM incoming_webhooks w\n  WHERE $__timeFilter(w.received_at)\n)\nSELECT COUNT(*) AS value\nFROM enriched\nWHERE status = 'received'\n  AND active = TRUE\n  AND ('${tenant}' = '__all' OR tenant = '${tenant}')\n  AND ('${app}' = '__all' OR app = '${app}')\n  AND ('${event}' = '__all' OR event = '${event}')\n  AND ('${payload_search}' = '' OR path ILIKE '%' || '${payload_search}' || '%' OR COALESCE(body_text, '') ILIKE '%' || '${payload_search}' || '%');"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "",
        "id": 1,
        "title": "In-Flight Received",
        "title": "Webhook Count",
        "vizConfig": {
          "group": "stat",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
