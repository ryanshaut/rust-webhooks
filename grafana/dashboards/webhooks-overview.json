                      "value": 0
                    }
                  ]
                },
                "unit": "none"
              },
              "overrides": []
            },
            "options": {
              "colorMode": "value",
              "graphMode": "none",
              "justifyMode": "auto",
              "orientation": "auto",
              "percentChangeColorMode": "standard",
              "reduceOptions": {
                "calcs": [
                  "lastNotNull"
                ],
                "fields": "",
                "values": false
              },
              "showPercentChange": false,
              "textMode": "auto",
              "wideLayout": true
            }
          },
          "version": "13.1.0"
        }
      }
    },
    "panel-10": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "$datasource"
                    },
                    "group": "postgres",
                    "kind": "DataQuery",
                    "spec": {
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH enriched AS (\n  SELECT\n    w.id,\n    w.received_at,\n    w.method,\n    w.path,\n    w.status,\n    w.active,\n    w.substatus,\n    w.intermediate_status,\n    w.status_text,\n    w.ttl_expires_at,\n    w.result,\n    w.extra_properties,\n    COALESCE(NULLIF(w.tenant, ''), 'unknown') AS tenant,\n    COALESCE(NULLIF(w.app, ''), 'unknown') AS app,\n    COALESCE(NULLIF(w.event, ''), 'unknown') AS event,\n    left(COALESCE(w.body_text, '[binary payload]'), 240) AS payload_preview\n  FROM incoming_webhooks w\n  WHERE $__timeFilter(w.received_at)\n)\nSELECT id, received_at, method, path, tenant, app, event, status, active, substatus, intermediate_status, status_text, ttl_expires_at, result, extra_properties, payload_preview\nFROM enriched\nWHERE ('${tenant}' = '__all' OR tenant = '${tenant}')\n  AND ('${app}' = '__all' OR app = '${app}')\n  AND ('${event}' = '__all' OR event = '${event}')\n  AND ('${payload_search}' = '' OR path ILIKE '%' || '${payload_search}' || '%' OR payload_preview ILIKE '%' || '${payload_search}' || '%')\nORDER BY received_at DESC\nLIMIT 100;"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "",
        "id": 10,
        "links": [],
        "title": "Recent Payload Explorer",
        "vizConfig": {
          "group": "table",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "thresholds"
                },
                "custom": {
                  "align": "auto",
                  "cellOptions": {
                    "type": "auto"
                  },
