                    "spec": {
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH enriched AS (\n  SELECT\n    COALESCE(NULLIF(w.tenant, ''), 'unknown') AS tenant,\n    COALESCE(NULLIF(w.app, ''), 'unknown') AS app,\n    COALESCE(NULLIF(w.event, ''), 'unknown') AS event,\n    w.path,\n    w.body_text\n  FROM incoming_webhooks w\n  WHERE $__timeFilter(w.received_at)\n)\nSELECT app, COUNT(*)::double precision AS webhook_count\nFROM enriched\nWHERE ('${tenant}' = '__all' OR tenant = '${tenant}')\n  AND ('${app}' = '__all' OR app = '${app}')\n  AND ('${event}' = '__all' OR event = '${event}')\n  AND ('${payload_search}' = '' OR path ILIKE '%' || '${payload_search}' || '%' OR COALESCE(body_text, '') ILIKE '%' || '${payload_search}' || '%')\nGROUP BY app\nORDER BY webhook_count DESC\nLIMIT 10;"
